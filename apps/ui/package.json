{
  "name": "vibesensor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "biome lint .",
    "lint:unused": "knip --config knip.jsonc",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome check . --linter-enabled=false --assist-enabled=false",
    "dev": "vite",
    "dev:open": "vite --open",
    "dev:docker": "sh ./dev-docker.sh",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:smoke": "npx playwright test --config=playwright.smoke.config.ts --project=laptop-light",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
