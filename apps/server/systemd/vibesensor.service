[Unit]
Description=VibeSensor FastAPI Server
# No network-online.target (nor NetworkManager.service): the server binds
# 0.0.0.0 and the car has no upstream network, so it starts in parallel with
# NetworkManager and vibesensor-hotspot.service instead of after the hotspot
# is up; its ~10 s Python startup was the tail of the cold boot. Restoring the
# hotspot after an interrupted Wi-Fi update retries `nmcli connection up`
# (updates/wifi/wifi_hotspot_recovery.py), so NetworkManager may still be
# starting then.
# Root commands (updater, Bluetooth OBD) go through this socket; see
# vibesensor-privileged.socket. NoNewPrivileges below rules out sudo.
Wants=vibesensor-privileged.socket
After=vibesensor-privileged.socket

[Service]
Type=simple
User=__SERVICE_USER__
PermissionsStartOnly=true
# CAP_SYS_TIME: the Pi has no RTC; the server steps an unsynchronised clock to
# the connected browser's clock (vibesensor/clock/browser_clock.py).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_TIME
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_TIME
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/vibesensor /var/log/vibesensor __VENV_DIR__
WorkingDirectory=__PI_DIR__
ExecStartPre=/usr/bin/test -r /etc/vibesensor/config.yaml
# Updates need writable runtime state. Keep startup repair scoped to runtime
# paths; install/update flows own the virtualenv and release tree setup.
ExecStartPre=/usr/bin/chown -R __SERVICE_USER__:__SERVICE_USER__ /var/log/vibesensor /var/lib/vibesensor
ExecStartPre=/usr/bin/test -w /var/log/vibesensor
ExecStartPre=/usr/bin/test -w /var/lib/vibesensor
ExecStartPre=/usr/bin/test -w __VENV_DIR__
ExecStart=__VENV_DIR__/bin/vibesensor-server --config /etc/vibesensor/config.yaml
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
