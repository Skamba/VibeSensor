[Unit]
Description=VibeSensor hotspot watchdog (bring the hotspot back up when it is down)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
# The timer owns cadence; each run is a single check and, if needed, one recovery pass.
# Runs as root from the root-owned helper directory, never from the service
# user's venv (install_systemd_units.sh).
ExecStart=/usr/bin/python3 -I /usr/local/lib/vibesensor/vibesensor_hotspot.py watchdog
SyslogIdentifier=vibesensor-hotspot-selfheal
