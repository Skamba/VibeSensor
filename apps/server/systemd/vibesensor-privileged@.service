[Unit]
Description=VibeSensor privileged helper request
CollectMode=inactive-or-failed

[Service]
# Runs as root. The script reads one JSON request from the connection and
# runs it only through the allowlist wrapper that the request names.
ExecStart=/usr/bin/python3 -I __PI_DIR__/scripts/vibesensor_privileged_helper.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
# The helper enforces each request's timeout (at most 600 s) itself.
RuntimeMaxSec=660
SyslogIdentifier=vibesensor-privileged
