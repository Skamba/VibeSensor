#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not installed; skipping secret scan (see CONTRIBUTING.md)." >&2
  exit 0
fi

zero_sha="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ -z "${local_sha:-}" || "${local_sha}" == "${zero_sha}" ]]; then
    continue
  fi

  if [[ "${remote_sha}" == "${zero_sha}" ]]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      log_opts="$(git merge-base origin/main "${local_sha}")..${local_sha}"
    else
      log_opts="${local_sha}"
    fi
  else
    log_opts="${remote_sha}..${local_sha}"
  fi

  gitleaks git --log-opts="${log_opts}" --redact --no-banner
done
